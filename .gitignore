# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.ruff_cache/

# Secrets - never commit
.env

# Generated data (fully reproducible from the seeded generator: python -m src.pipeline)
data/raw/
data/*.db
logs/
scripts/_tmp/

# Playwright working files (only the final screenshots/gif are committed)
docs/screenshots/_video/
docs/screenshots/_demo.webm

# Power BI export (CSV + Parquet, ~50 MB) is regenerated by the pipeline
powerbi/data/

# Local caches kept on D: (pip, temp files, Kaggle download zip)
.cache/
