# Copy to .env and adjust. .env is gitignored.
# Default (no DATABASE_URL): local SQLite file data/retaillens.db
# PostgreSQL example (matches docker-compose.yml, host port 5440):
# DATABASE_URL=postgresql+psycopg2://retaillens:change_me@localhost:5440/retaillens
POSTGRES_USER=retaillens
POSTGRES_PASSWORD=change_me
POSTGRES_DB=retaillens
# Which Olist folder the pipeline reads: data/raw (full Kaggle download) or data/sample (committed)
# RETAILLENS_RAW_DIR=data/sample
